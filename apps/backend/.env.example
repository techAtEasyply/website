# Backend environment variables
# Copy this file to .env and fill in the actual values.

# --- Server ---
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Database (Prisma) ---
DATABASE_URL=

# --- AI / LLM providers ---
# LLM currently runs through a local Ollama instance.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Text-to-speech ---
# Defaults to the hosted Modal endpoint if left unset.
TTS_API_URL=https://priyanshu1976--ai-mock-tts-synthesize.modal.run
